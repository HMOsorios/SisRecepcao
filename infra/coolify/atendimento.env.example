# Copie este arquivo para o painel "Environment Variables" do recurso
# sisrecepcao-atendimento no Coolify (ajuste os valores de produção).
APP_NAME="SisRecepcao Atendimento"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://atendimento.sisrecepcao.test
APP_TIMEZONE=America/Sao_Paulo
APP_VERSION=2.0.0

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<host-do-mysql>
DB_PORT=3306
DB_DATABASE=sisrecepcao_db
DB_USERNAME=<usuario>
DB_PASSWORD=<senha>

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="atendimento@sisrecepcao.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Integração NovoSGA ----
NOVOSGA_BASE_URL=https://novosga.sms.local
NOVOSGA_CLIENT_ID=sisrecepcao_atendimento
NOVOSGA_CLIENT_SECRET=<secret-da-conta-de-servico>
NOVOSGA_USERNAME=
NOVOSGA_PASSWORD=
NOVOSGA_TIMEOUT=5
NOVOSGA_RETRIES=3

# Unidade "Sede SMS" no NovoSGA
SMS_UNIDADE_ID=1

# ---- Mercure (hub compartilhado) ----
MERCURE_URL=https://mercure.sisrecepcao.test/.well-known/mercure
MERCURE_PUBLISHER_KEY=
MERCURE_SUBSCRIBER_KEY=
MERCURE_JWT=

# ---- Keycloak ----
KEYCLOAK_BASE_URL=https://sso.sms.local
KEYCLOAK_REALM=sisrecepcao
KEYCLOAK_CLIENT_ID=sisrecepcao-atendimento
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://atendimento.sisrecepcao.test/auth/callback

# ---- Totem / Segurança ----
TOTEM_RATE_LIMIT=12
TOTEM_PRINT_URL=http://localhost:8080/print

VITE_APP_NAME="${APP_NAME}"
