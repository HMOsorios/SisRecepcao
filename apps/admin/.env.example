APP_NAME="SisRecepcao Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://admin.sisrecepcao.test
APP_VERSION=2.0.0

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisrecepcao_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@sisrecepcao.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Dados institucionais (SMS) ----
SMS_NOME="Secretaria Municipal de Saúde"
SMS_SIGLA=SMS
SMS_IDENTIDADE="Prefeitura Municipal"
SMS_ENDERECO=
SMS_TELEFONE=
SMS_EMAIL=
SMS_UNIDADE_ID=1

# ---- BI ----
BI_AMOSTRA=500

# ---- Keycloak ----
KEYCLOAK_BASE_URL=http://keycloak.test
KEYCLOAK_REALM=sisrecepcao
KEYCLOAK_CLIENT_ID=sisrecepcao-admin
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://admin.sisrecepcao.test/auth/callback
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# ---- NovoSGA (leitura para BI) ----
NOVOSGA_BASE_URL=http://novosga.test
NOVOSGA_CLIENT_ID=sisrecepcao_admin
NOVOSGA_CLIENT_SECRET=
NOVOSGA_USERNAME=
NOVOSGA_PASSWORD=
NOVOSGA_TIMEOUT=5
NOVOSGA_RETRIES=3
NOVOSGA_SIMULATION=true

# ---- Deploy / Coolify ----
GITHUB_REPO=HMOsorios/sisrecepcao
COOLIFY_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
