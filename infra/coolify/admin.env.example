# Copie este arquivo para o painel "Environment Variables" do recurso
# sisrecepcao-admin no Coolify (ajuste os valores de produção).
APP_NAME="SisRecepcao Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.sisrecepcao.test
APP_VERSION=2.0.0

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<host-do-mysql>
DB_PORT=3306
DB_DATABASE=sisrecepcao_db
DB_USERNAME=<usuario>
DB_PASSWORD=<senha>

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@sisrecepcao.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Dados institucionais (SMS) ----
SMS_NOME="Secretaria Municipal de Saúde"
SMS_SIGLA=SMS
SMS_IDENTIDADE="Prefeitura Municipal"
SMS_ENDERECO=
SMS_TELEFONE=
SMS_EMAIL=
SMS_UNIDADE_ID=1

# ---- BI ----
BI_AMOSTRA=500

# ---- Keycloak ----
KEYCLOAK_BASE_URL=https://sso.sms.local
KEYCLOAK_REALM=sisrecepcao
KEYCLOAK_CLIENT_ID=sisrecepcao-admin
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://admin.sisrecepcao.test/auth/callback
KEYCLOAK_ADMIN_USER=<usuario.realm-admin>
KEYCLOAK_ADMIN_PASSWORD=<senha-do-realm-admin>

# ---- NovoSGA (leitura para BI) ----
NOVOSGA_BASE_URL=https://novosga.sms.local
NOVOSGA_CLIENT_ID=sisrecepcao_admin
NOVOSGA_CLIENT_SECRET=<secret>
NOVOSGA_USERNAME=
NOVOSGA_PASSWORD=
NOVOSGA_TIMEOUT=5
NOVOSGA_RETRIES=3
NOVOSGA_SIMULATION=false

# ---- Deploy / Coolify ----
GITHUB_REPO=HMOsorios/sisrecepcao
COOLIFY_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
