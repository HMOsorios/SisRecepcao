# Secret compartilhada com o NovoSGA (MERCURE_JWT_SECRET do .env do NovoSGA).
MERCURE_JWT_SECRET=!ChangeThisMercureHubJWTSecretKey!

# URL pública usada pelos navegadores (EventSource).
MERCURE_PUBLIC_URL=https://mercure.sisrecepcao.test/.well-known/mercure

# Origens permitidas (CORS) para o SSE.
MERCURE_CORS_ORIGINS=https://*.sisrecepcao.test

# Porta HTTP do hub (mantém 3000 = compatível com o padrão do NovoSGA).
MERCURE_HTTP_PORT=3000
