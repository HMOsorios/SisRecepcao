APP_NAME=SisRecepcao Atendimento
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://atendimento.sisrecepcao.test
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco compartilhado SisRecepcao (MySQL 8.0+ / MariaDB 10.6+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sisrecepcao_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="atendimento@sisrecepcao.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Integração NovoSGA (motor de filas — Modelo 1, Seção 4.1/5.4) ----
NOVOSGA_BASE_URL=http://novosga.test
# Conta de serviço (client_credentials grant no OAuth2 do NovoSGA)
NOVOSGA_CLIENT_ID=sisrecepcao_atendimento
NOVOSGA_CLIENT_SECRET=
NOVOSGA_USERNAME=
NOVOSGA_PASSWORD=
# Modo de simulação: quando o NovoSGA está indisponível, emite senha provisória local (Seção 9.1)
NOVOSGA_TIMEOUT=5
NOVOSGA_RETRIES=3

# Unidade "Sede SMS" no NovoSGA (Seção 2.6)
SMS_UNIDADE_ID=1

# Mercure hub compartilhado com o NovoSGA (Seção 5.2)
MERCURE_URL=http://mercure.test/.well-known/mercure
MERCURE_PUBLISHER_KEY=
MERCURE_SUBSCRIBER_KEY=
MERCURE_JWT=

# ---- Keycloak (IdP central — Seção 5.4/8.6) ----
KEYCLOAK_BASE_URL=http://keycloak.test
KEYCLOAK_REALM=sisrecepcao
KEYCLOAK_CLIENT_ID=sisrecepcao-atendimento
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://atendimento.sisrecepcao.test/auth/callback

# ---- Totem / Segurança (Seção 8.8) ----
TOTEM_RATE_LIMIT=12
TOTEM_PRINT_URL=http://localhost:8080/print  # ponte ESC/POS local (Seção 9.7)

VITE_APP_NAME="${APP_NAME}"
